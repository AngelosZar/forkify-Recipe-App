{
  "extends": "@parcel/config-default",
  "optimizers": {
    "*.svg": [
      {
        "name": "@parcel/optimizer-svgo",
        "options": {
          "plugins": [
            {
              "name": "preset-default"
            },
            "cleanupIDs"
          ]
        }
      }
    ]
  }
}
